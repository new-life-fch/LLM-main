"""动态候选三元组筛选器
基于输入文本实时筛选相关的候选知识三元组
"""

import re
import logging
from typing import List, Dict, Any, Optional, Set, Tuple
from collections import defaultdict
import torch
from transformers import AutoTokenizer
import json
import os
import sqlite3
import threading
from pathlib import Path
from .web_knowledge_retriever import WebKnowledgeRetriever, RetrievalStrategy
from .entity_extractor import EntityExtractionManager, EntityExtractionMethod
from ..utils.path_config import get_path_config, get_web_knowledge_paths


class DynamicCandidateFilter:
    """动态候选三元组筛选器
    
    基于输入文本的实体识别和关系推断，快速筛选出可能相关的候选三元组
    """
    
    def __init__(
        self,
        model_name: str = "meta-llama/Llama-2-7b-hf",
        max_candidates: int = 100,
        entity_confidence_threshold: float = 0.6,
        cache_size: int = 20000,
        knowledge_base_path: Optional[str] = None,
        enable_web_retrieval: bool = True,
        web_retrieval_strategy: RetrievalStrategy = RetrievalStrategy.HYBRID,
        max_web_results: int = 50,
        web_cache_dir: Optional[str] = None,
        entity_extraction_method: EntityExtractionMethod = EntityExtractionMethod.HYBRID,
        save_web_results_to_local: bool = True
    ):
        """初始化动态候选筛选器
        
        Args:
            model_name: 模型名称，用于tokenizer
            max_candidates: 最大候选数量
            entity_confidence_threshold: 实体置信度阈值
            cache_size: 缓存大小
            knowledge_base_path: 知识库路径
            enable_web_retrieval: 是否启用网络知识获取
            web_retrieval_strategy: 网络获取策略
            max_web_results: 最大网络获取结果数
            web_cache_dir: 网络缓存目录（可选，使用统一路径配置）
            entity_extraction_method: 实体提取方法
            save_web_results_to_local: 是否将网络获取结果保存到本地知识库
        """
        # 初始化路径配置
        self.path_config = get_path_config()
        web_paths = get_web_knowledge_paths()
        
        self.model_name = model_name
        self.max_candidates = max_candidates
        self.entity_confidence_threshold = entity_confidence_threshold
        self.cache_size = cache_size
        self.knowledge_base_path = knowledge_base_path
        self.save_web_results_to_local = save_web_results_to_local
        self.web_cache_dir = web_cache_dir if web_cache_dir else web_paths["cache_dir"]
        
        # 初始化tokenizer
        try:
            self.tokenizer = AutoTokenizer.from_pretrained(model_name, trust_remote_code=True)
            if self.tokenizer.pad_token is None:
                self.tokenizer.pad_token = self.tokenizer.eos_token
        except Exception as e:
            logging.warning(f"无法加载tokenizer {model_name}: {e}")
            self.tokenizer = None
            
        # 初始化实体提取管理器
        self.entity_extractor = EntityExtractionManager(entity_extraction_method)
            
        # TODO: 完善实体识别模式
        self.entity_patterns = [
            (r'\b[A-Z][a-z]+(?:\s+[A-Z][a-z]+)*\b', 'PERSON_PLACE'),  # 人名、地名
            (r'\b\d{4}\b', 'YEAR'),  # 年份
            (r'\b\d+(?:\.\d+)?\s*(?:km|米|公里|英里|mile)\b', 'DISTANCE'),  # 距离
            (r'\b\d+(?:\.\d+)?\s*(?:kg|克|公斤|磅|pound)\b', 'WEIGHT'),  # 重量
            (r'\b[A-Z][A-Za-z]*(?:\s+[A-Z][A-Za-z]*)*\b', 'PROPER_NOUN'),  # 专有名词
        ]
        
        # TODO: 完善关系模式映射
        self.relation_patterns = {
            # 地理关系
            r'(?:位于|在|坐落于|地处)': ['located_in', 'situated_in'],
            r'(?:首都|capital)': ['capital_of'],
            r'(?:距离|相距)': ['distance_from'],
            
            # 人物关系
            r'(?:出生于|born in)': ['born_in'],
            r'(?:死于|died in)': ['died_in'],
            r'(?:职业|工作|profession)': ['occupation'],
            r'(?:国籍|nationality)': ['nationality'],
            
            # 科学关系
            r'(?:由.*组成|composed of|made of)': ['composed_of'],
            r'(?:发现|discovered)': ['discovered_by'],
            r'(?:发明|invented)': ['invented_by'],
            
            # 时间关系
            r'(?:发生于|occurred in)': ['occurred_in'],
            r'(?:建立于|founded in)': ['founded_in'],
            
            # 分类关系
            r'(?:是.*的一种|is a type of)': ['instance_of'],
            r'(?:属于|belongs to)': ['belongs_to'],
        }
        
        # TODO: 目前为手动定义内置知识库（轻量级），后续可考虑10万热门实体每个实体100条三元组直接拉取下来
        self.builtin_knowledge = self._init_builtin_knowledge()
        
        # 初始化缓存
        self.entity_cache = {}
        self.relation_cache = {}
        self.candidate_cache = {}

        # TODO: 后期增加大量外部实体后，将热门实体使用内存索引，次热门实体，使用SQLite索引，没有的实体，采用网络获取并加入SQLite中
        # 建议的实现步骤 
        # 1.保持现有内存索引不变 
        # 2.添加 SQLite 查询接口 
        # 3.实现分层查询逻辑 
        # 4.优化缓存策略
        
        # 高效索引结构
        self._subject_index = defaultdict(list)
        self._object_index = defaultdict(list)
        self._relation_index = defaultdict(list)
        self._build_indices() 

        # 加载外部知识库 TODO: 如果之后使用SQLite，则衡量这部分代码的可用性
        self.knowledge_base = self._load_knowledge_base(knowledge_base_path)
        
        # 网络知识获取器
        self.enable_web_retrieval = enable_web_retrieval
        self.max_web_results = max_web_results
        if enable_web_retrieval:
            self.web_retriever = WebKnowledgeRetriever(
                strategy=web_retrieval_strategy,
                cache_dir=web_cache_dir,
                max_cache_size=cache_size,
                rate_limit_delay=1.0  # 稍微保守的请求间隔
            )
        else:
            self.web_retriever = None
        
        # 统计信息
        self.filter_count = 0 # 筛选数量
        self.cache_hits = 0 # 缓存命中数量
        self.total_candidates_found = 0 # 总候选数量
        self.web_retrieval_count = 0 # 网络检索次数
        self.web_triples_found = 0 # 网络检索三元组数量
        self.local_query_count = 0 # 本地查询次数
        self.local_hits = 0 # 本地命中数量
        self.web_results_saved = 0 # 网络结果保存数量
        
        # 动态候选筛选器初始化完成
    
    def _load_knowledge_base(self, knowledge_base_path: Optional[str]) -> List[Dict[str, Any]]:
        """加载外部知识库"""
        if not knowledge_base_path or not os.path.exists(knowledge_base_path):
            return []
        
        try:
            with open(knowledge_base_path, 'r', encoding='utf-8') as f:
                knowledge_base = json.load(f)
            # 重建外部知识库索引
            self._rebuild_external_indices()
            return knowledge_base
        except Exception as e:
            logging.warning(f"无法加载知识库 {knowledge_base_path}: {e}")
            return []
    
    def _init_builtin_knowledge(self) -> List[Dict[str, Any]]:
        """初始化内置轻量级知识库"""
        return [
            # 地理关系
            {"subject": "Paris", "relation": "capital_of", "object": "France", "confidence": 0.95},
            {"subject": "London", "relation": "capital_of", "object": "United Kingdom", "confidence": 0.95},
            {"subject": "Tokyo", "relation": "capital_of", "object": "Japan", "confidence": 0.95},
            {"subject": "Beijing", "relation": "capital_of", "object": "China", "confidence": 0.95},
            {"subject": "Washington D.C.", "relation": "capital_of", "object": "United States", "confidence": 0.95},
            {"subject": "Berlin", "relation": "capital_of", "object": "Germany", "confidence": 0.95},
            {"subject": "Rome", "relation": "capital_of", "object": "Italy", "confidence": 0.95},
            {"subject": "Madrid", "relation": "capital_of", "object": "Spain", "confidence": 0.95},
            
            # 科学关系
            {"subject": "Albert Einstein", "relation": "known_for", "object": "Theory of Relativity", "confidence": 0.9},
            {"subject": "Isaac Newton", "relation": "known_for", "object": "Laws of Motion", "confidence": 0.9},
            {"subject": "Marie Curie", "relation": "known_for", "object": "Radioactivity", "confidence": 0.9},
            {"subject": "Charles Darwin", "relation": "known_for", "object": "Theory of Evolution", "confidence": 0.9},
            {"subject": "Galileo Galilei", "relation": "known_for", "object": "Telescope", "confidence": 0.85},
            
            # 技术关系
            {"subject": "Python", "relation": "type_of", "object": "Programming Language", "confidence": 0.85},
            {"subject": "JavaScript", "relation": "type_of", "object": "Programming Language", "confidence": 0.85},
            {"subject": "Java", "relation": "type_of", "object": "Programming Language", "confidence": 0.85},
            {"subject": "C++", "relation": "type_of", "object": "Programming Language", "confidence": 0.85},
            {"subject": "HTML", "relation": "type_of", "object": "Markup Language", "confidence": 0.8},
            
            # 历史关系
            {"subject": "World War II", "relation": "ended_in", "object": "1945", "confidence": 0.9},
            {"subject": "World War I", "relation": "ended_in", "object": "1918", "confidence": 0.9},
            {"subject": "American Civil War", "relation": "ended_in", "object": "1865", "confidence": 0.9},
            
            # 文学关系
            {"subject": "William Shakespeare", "relation": "wrote", "object": "Hamlet", "confidence": 0.95},
            {"subject": "William Shakespeare", "relation": "wrote", "object": "Romeo and Juliet", "confidence": 0.95},
            {"subject": "Mark Twain", "relation": "wrote", "object": "The Adventures of Tom Sawyer", "confidence": 0.9},
            
            # 数学关系
            {"subject": "Pythagoras", "relation": "known_for", "object": "Pythagorean Theorem", "confidence": 0.9},
            {"subject": "Euclid", "relation": "known_for", "object": "Euclidean Geometry", "confidence": 0.9},
            
            # 艺术关系
            {"subject": "Leonardo da Vinci", "relation": "painted", "object": "Mona Lisa", "confidence": 0.95},
            {"subject": "Vincent van Gogh", "relation": "painted", "object": "Starry Night", "confidence": 0.9},
            {"subject": "Pablo Picasso", "relation": "painted", "object": "Guernica", "confidence": 0.9},
        ]
    
    def _build_indices(self):
        """构建高效的倒排索引"""
        # 为内置知识库构建索引
        for i, knowledge in enumerate(self.builtin_knowledge):
            self._subject_index[knowledge['subject'].lower()].append(('builtin', i)) # builtin表示数据来自内置知识库，i表示数据在builtinknowledge中的索引
            self._object_index[knowledge['object'].lower()].append(('builtin', i))
            self._relation_index[knowledge['relation']].append(('builtin', i))
    
    def _rebuild_external_indices(self):
        """重建外部知识库索引"""
        # 清空外部索引
        for key in list(self._subject_index.keys()):
            self._subject_index[key] = [item for item in self._subject_index[key] if item[0] == 'builtin']
        for key in list(self._object_index.keys()):
            self._object_index[key] = [item for item in self._object_index[key] if item[0] == 'builtin']
        for key in list(self._relation_index.keys()):
            self._relation_index[key] = [item for item in self._relation_index[key] if item[0] == 'builtin']
        
        # 为外部知识库构建索引
        for i, knowledge in enumerate(self.knowledge_base):
            self._subject_index[knowledge['subject'].lower()].append(('external', i))
            self._object_index[knowledge['object'].lower()].append(('external', i))
            self._relation_index[knowledge['relation']].append(('external', i))
    
    def _fast_candidate_search(self, entity_texts: Set[str], possible_relations: List[str]) -> List[Dict[str, Any]]:
        """使用索引进行快速候选搜索"""
        candidates = []
        candidate_keys = set()  # 用于去重
        
        # 通过主语索引搜索
        for entity in entity_texts:
            entity_lower = entity.lower()
            if entity_lower in self._subject_index:
                for source, idx in self._subject_index[entity_lower]:
                    knowledge = self.builtin_knowledge[idx] if source == 'builtin' else self.knowledge_base[idx]
                    candidate_key = (knowledge['subject'], knowledge['relation'], knowledge['object'])
                    if candidate_key not in candidate_keys:
                        candidate = self._create_candidate(knowledge, source, 0.6)  # 主语匹配得分
                        candidates.append(candidate)
                        candidate_keys.add(candidate_key)
        
        # 通过宾语索引搜索
        for entity in entity_texts:
            entity_lower = entity.lower()
            if entity_lower in self._object_index:
                for source, idx in self._object_index[entity_lower]:
                    knowledge = self.builtin_knowledge[idx] if source == 'builtin' else self.knowledge_base[idx]
                    candidate_key = (knowledge['subject'], knowledge['relation'], knowledge['object'])
                    if candidate_key not in candidate_keys:
                        candidate = self._create_candidate(knowledge, source, 0.6)  # 宾语匹配得分
                        candidates.append(candidate)
                        candidate_keys.add(candidate_key)
        
        # 通过关系索引搜索
        for relation in possible_relations:
            if relation in self._relation_index:
                for source, idx in self._relation_index[relation]:
                    knowledge = self.builtin_knowledge[idx] if source == 'builtin' else self.knowledge_base[idx]
                    candidate_key = (knowledge['subject'], knowledge['relation'], knowledge['object'])
                    if candidate_key not in candidate_keys:
                        # 检查是否也有实体匹配
                        subject_match = knowledge['subject'].lower() in {e.lower() for e in entity_texts}
                        object_match = knowledge['object'].lower() in {e.lower() for e in entity_texts}
                        if subject_match or object_match:
                            base_score = 0.4 if subject_match else 0.0
                            base_score += 0.4 if object_match else 0.0
                            base_score += 0.2  # 关系匹配
                            candidate = self._create_candidate(knowledge, source, base_score)
                            candidates.append(candidate)
                            candidate_keys.add(candidate_key)
        
        return candidates
    
    def _create_candidate(self, knowledge: Dict[str, Any], source: str, base_score: float) -> Dict[str, Any]:
        """创建候选三元组"""
        return {
            'subject': knowledge['subject'],
            'relation': knowledge['relation'],
            'object': knowledge['object'],
            'confidence': knowledge.get('confidence', 0.8),
            'match_score': base_score,
            'text': f"{knowledge['subject']} {knowledge['relation']} {knowledge['object']}.",
            'source': source
        }
    
    def extract_entities(self, text: str) -> List[Dict[str, Any]]:
        """从文本中提取实体
        
        Args:
            text: 输入文本
            
        Returns:
            实体列表，包含实体文本、类型和置信度
        """
        # 检查缓存
        if text in self.entity_cache:
            return self.entity_cache[text]
            
        # 使用实体提取管理器
        entities = self.entity_extractor.extract_entities(text)
        
        # 过滤低置信度实体
        filtered_entities = [e for e in entities if e['confidence'] >= self.entity_confidence_threshold]
        
        # 缓存结果
        if len(self.entity_cache) < self.cache_size:
            self.entity_cache[text] = filtered_entities
            
        return filtered_entities
    
    def _calculate_entity_confidence(self, entity_text: str, entity_type: str) -> float:
        """计算实体置信度"""
        confidence = 0.5  # 基础置信度
        
        # 根据长度调整
        if len(entity_text) > 10:
            confidence += 0.2
        elif len(entity_text) > 5:
            confidence += 0.1
            
        # 根据类型调整
        if entity_type in ['PERSON_PLACE', 'PROPER_NOUN']:
            confidence += 0.2
        elif entity_type in ['YEAR', 'DISTANCE', 'WEIGHT']:
            confidence += 0.3
            
        # 检查是否在内置知识库中
        for knowledge in self.builtin_knowledge:
            if entity_text.lower() in [knowledge['subject'].lower(), knowledge['object'].lower()]:
                confidence += 0.3
                break
                
        return min(confidence, 1.0)
    
    def _deduplicate_entities(self, entities: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
        """去除重叠的实体"""
        if not entities:
            return entities
            
        # 按位置排序
        entities.sort(key=lambda x: (x['start'], x['end']))
        
        deduplicated = []
        for entity in entities:
            # 检查是否与已有实体重叠
            overlap = False
            for existing in deduplicated:
                if (entity['start'] < existing['end'] and entity['end'] > existing['start']):
                    # 有重叠，保留置信度更高的
                    if entity['confidence'] > existing['confidence']:
                        deduplicated.remove(existing)
                        deduplicated.append(entity)
                    overlap = True
                    break
            
            if not overlap:
                deduplicated.append(entity)
                
        return deduplicated
    
    def infer_relations(self, text: str, entities: List[Dict[str, Any]]) -> List[str]:
        """从文本中推断可能的关系
        
        Args:
            text: 输入文本
            entities: 提取的实体列表
            
        Returns:
            可能的关系列表
        """
        relations = set()
        
        # 基于模式匹配推断关系
        for pattern, relation_list in self.relation_patterns.items():
            if re.search(pattern, text, re.IGNORECASE):
                relations.update(relation_list)
        
        # 基于实体类型推断关系
        entity_types = [e['type'] for e in entities]
        
        if 'PERSON_PLACE' in entity_types:
            relations.update(['born_in', 'died_in', 'lived_in', 'nationality'])
        
        if 'YEAR' in entity_types:
            relations.update(['occurred_in', 'founded_in', 'born_in', 'died_in'])
            
        if len([e for e in entities if e['type'] == 'PROPER_NOUN']) >= 2:
            relations.update(['located_in', 'capital_of', 'part_of', 'instance_of'])
            
        return list(relations)
    
    def filter_candidates(
        self, 
        text: str, 
        generation_context: Optional[Dict[str, Any]] = None
    ) -> List[Dict[str, Any]]:
        """筛选候选三元组
        
        Args:
            text: 输入文本
            generation_context: 生成上下文信息
            
        Returns:
            候选三元组列表
        """
        self.filter_count += 1
        
        # 检查缓存 # TODO: 缓存的key有点问题，他是根据text和generation_context的hash值来缓存的，但是text是不会相同的。
        cache_key = f"{text}_{hash(str(generation_context))}"
        if cache_key in self.candidate_cache:
            self.cache_hits += 1
            return self.candidate_cache[cache_key]
        
        # 提取实体
        entities = self.extract_entities(text)
        
        if not entities:
            return []
        
        # 推断关系
        possible_relations = self.infer_relations(text, entities)
        
        # 使用高效索引搜索候选
        entity_texts = {e['text'] for e in entities}
        candidates = self._fast_candidate_search(entity_texts, possible_relations)
        
        # 网络知识获取（只有在本地候选不足时才触发）
        self.local_query_count += 1
        if len(candidates) > 0:
            self.local_hits += 1
            
        if (self.enable_web_retrieval and 
            self.web_retriever and 
            len(candidates) < self.max_candidates // 2):  # 本地候选不足时启用网络获取
            
            try:
                self.web_retrieval_count += 1
                entity_texts_list = [e['text'] for e in entities]
                
                # 获取网络知识
                web_triples = self.web_retriever.retrieve_knowledge(
                    entities=entity_texts_list,
                    relations=possible_relations,
                    max_results=self.max_web_results
                )
                
                # 转换为候选格式并保存到本地
                web_candidates = []
                for triple in web_triples:
                    # 计算与输入实体的匹配分数
                    match_score = 0.0
                    if any(entity.lower() in triple.subject.lower() for entity in entity_texts_list):
                        match_score += 0.4
                    if any(entity.lower() in triple.object.lower() for entity in entity_texts_list):
                        match_score += 0.4
                    if triple.relation in possible_relations:
                        match_score += 0.2
                    
                    candidate = {
                        'subject': triple.subject,
                        'relation': triple.relation,
                        'object': triple.object,
                        'confidence': triple.confidence,
                        'match_score': match_score,
                        'text': f"{triple.subject} {triple.relation} {triple.object}.",
                        'source': f'web_{triple.source}',
                        'evidence_text': triple.evidence_text,
                        'source_url': triple.source_url,
                        'timestamp': triple.timestamp
                    }
                    web_candidates.append(candidate)
                    candidates.append(candidate)
                
                # 保存网络获取的结果到本地知识库
                if self.save_web_results_to_local and web_candidates:
                    self._save_web_results_to_local(web_candidates)
                
                self.web_triples_found += len(web_triples)
                # 从网络获取知识三元组
                
            except Exception as e:
                logging.warning(f"网络知识获取失败: {e}")
        
        # 按匹配分数排序并限制数量
        candidates.sort(key=lambda x: x['match_score'], reverse=True)
        candidates = candidates[:self.max_candidates]
        
        self.total_candidates_found += len(candidates)
        
        # 缓存结果
        if len(self.candidate_cache) >= self.cache_size:
            # 简单的LRU：删除最旧的条目
            oldest_key = next(iter(self.candidate_cache))
            del self.candidate_cache[oldest_key]
        self.candidate_cache[cache_key] = candidates
            
        # 筛选候选三元组完成
        return candidates
    
    def _save_web_results_to_local(self, web_candidates: List[Dict[str, Any]]):
        """将网络获取的结果保存到本地知识库"""
        if not self.knowledge_base_path:
            return
            
        try:
            # 读取现有知识库
            existing_knowledge = []
            if os.path.exists(self.knowledge_base_path):
                with open(self.knowledge_base_path, 'r', encoding='utf-8') as f:
                    existing_knowledge = json.load(f)
            
            # 添加新的知识三元组（去重）
            existing_triples = {(k['subject'], k['relation'], k['object']) for k in existing_knowledge}
            new_count = 0
            
            for candidate in web_candidates:
                triple_key = (candidate['subject'], candidate['relation'], candidate['object'])
                if triple_key not in existing_triples:
                    new_knowledge = {
                        'subject': candidate['subject'],
                        'relation': candidate['relation'],
                        'object': candidate['object'],
                        'confidence': candidate['confidence'],
                        'source': candidate['source'],
                        'timestamp': candidate.get('timestamp')
                    }
                    existing_knowledge.append(new_knowledge)
                    existing_triples.add(triple_key)
                    new_count += 1
            
            # 保存更新后的知识库
            if new_count > 0:
                with open(self.knowledge_base_path, 'w', encoding='utf-8') as f:
                    json.dump(existing_knowledge, f, ensure_ascii=False, indent=2)
                
                # 更新内存中的知识库
                self.knowledge_base = existing_knowledge
                self.web_results_saved += new_count
                # 保存新的网络知识三元组到本地知识库
                
        except Exception as e:
            logging.warning(f"保存网络知识到本地失败: {e}")
    
    def get_statistics(self) -> Dict[str, Any]:
        """获取统计信息"""
        stats = {
            "filter_count": self.filter_count,
            "cache_hits": self.cache_hits,
            "cache_hit_rate": self.cache_hits / max(self.filter_count, 1),
            "total_candidates_found": self.total_candidates_found,
            "avg_candidates_per_query": self.total_candidates_found / max(self.filter_count, 1),
            "builtin_knowledge_size": len(self.builtin_knowledge),
            "external_knowledge_size": len(self.knowledge_base),
            "cache_size": len(self.candidate_cache),
            "local_query_count": self.local_query_count,
            "local_hits": self.local_hits,
            "local_hit_rate": self.local_hits / max(self.local_query_count, 1),
            "web_results_saved": self.web_results_saved
        }
        
        # 添加网络获取统计
        if self.enable_web_retrieval:
            stats.update({
                "web_retrieval_enabled": True,
                "web_retrieval_count": self.web_retrieval_count,
                "web_triples_found": self.web_triples_found,
                "avg_web_triples_per_retrieval": self.web_triples_found / max(self.web_retrieval_count, 1)
            })
            if self.web_retriever:
                stats.update(self.web_retriever.get_statistics())
        else:
            stats["web_retrieval_enabled"] = False
        
        # 实体提取统计
        stats["entity_extraction_stats"] = self.entity_extractor.get_statistics()
            
        return stats
    
    def reset_statistics(self):
        """重置统计信息"""
        self.filter_count = 0
        self.cache_hits = 0
        self.total_candidates_found = 0
        self.web_retrieval_count = 0
        self.web_triples_found = 0
        self.local_query_count = 0
        self.local_hits = 0
        self.web_results_saved = 0
        if self.web_retriever:
            self.web_retriever.reset_statistics()
        
        # 重置实体提取器统计
        for extractor in self.entity_extractor.extractors.values():
            extractor.extraction_count = 0
            extractor.total_entities_found = 0
    
    def clear_cache(self):
        """清空缓存"""
        self.entity_cache.clear()
        self.relation_cache.clear()
        self.candidate_cache.clear()
        if self.web_retriever:
            self.web_retriever.clear_cache()
        # 候选筛选器缓存已清空
    
    def set_web_retrieval_strategy(self, strategy: RetrievalStrategy):
        """设置网络获取策略
        
        Args:
            strategy: 新的获取策略
        """
        if self.web_retriever:
            self.web_retriever.set_strategy(strategy)
            # 网络知识获取策略已更新
        else:
            logging.warning("网络知识获取未启用，无法设置策略")
    
    def toggle_web_retrieval(self, enabled: bool):
        """启用或禁用网络知识获取
        
        Args:
            enabled: 是否启用网络获取
        """
        if enabled and not self.enable_web_retrieval:
            if not self.web_retriever:
                # 如果之前未初始化，现在初始化
                self.web_retriever = WebKnowledgeRetriever(
                    strategy=RetrievalStrategy.HYBRID,
                    cache_dir=self.web_cache_dir,
                    max_cache_size=1000,
                    rate_limit_delay=1.5
                )
            self.enable_web_retrieval = True
            # 网络知识获取已启用
        elif not enabled and self.enable_web_retrieval:
            self.enable_web_retrieval = False
            # 网络知识获取已禁用
    
    def get_available_strategies(self) -> List[str]:
        """获取可用的网络获取策略列表
        
        Returns:
            策略名称列表
        """
        return [strategy.value for strategy in RetrievalStrategy]
    
    def set_entity_extraction_method(self, method: EntityExtractionMethod):
        """设置实体提取方法"""
        self.entity_extractor.set_method(method)
        # 清空实体缓存，因为提取方法已改变
        self.entity_cache.clear()
        # 实体提取方法已切换
    
    def get_current_entity_extraction_method(self) -> str:
        """获取当前实体提取方法"""
        return self.entity_extractor.get_current_method()
    
    def get_available_entity_extraction_methods(self) -> List[str]:
        """获取可用的实体提取方法"""
        return self.entity_extractor.get_available_methods()